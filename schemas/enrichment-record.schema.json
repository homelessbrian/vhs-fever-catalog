{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homelessbrian/vhs-fever-catalog/blob/main/schemas/enrichment-record.schema.json",
  "title": "VHS FEVER Enrichment Record",
  "description": "Versioned sidecar record for title identity, VHS editions, artwork assets, and rights-aware display selection.",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "identity_match",
    "vhs_sleeve_lookup",
    "artwork"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_match": {
      "$ref": "#/$defs/identityMatch"
    },
    "vhs_sleeve_lookup": {
      "$ref": "#/$defs/sleeveLookup"
    },
    "artwork": {
      "$ref": "#/$defs/artwork"
    }
  },
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "mediaType": {
      "enum": [
        "movie",
        "tv"
      ]
    },
    "identityMatch": {
      "type": "object",
      "required": [
        "status",
        "provider",
        "provider_id",
        "media_type",
        "title",
        "year",
        "confidence",
        "evidence",
        "candidates",
        "external_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "unmatched",
            "candidate",
            "confirmed",
            "rejected"
          ]
        },
        "provider": {
          "enum": [
            "tmdb",
            null
          ]
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "media_type": {
          "oneOf": [
            {
              "$ref": "#/$defs/mediaType"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1888,
          "maximum": 2200
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "external_ids": {
          "type": "object",
          "properties": {
            "imdb_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^tt[0-9]+$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unmatched",
                  "candidate",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "type": "null"
              },
              "provider_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "const": "tmdb"
              },
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "media_type": {
                "$ref": "#/$defs/mediaType"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "provider",
        "provider_id",
        "media_type",
        "title",
        "year",
        "confidence",
        "evidence"
      ],
      "properties": {
        "provider": {
          "const": "tmdb"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1888,
          "maximum": 2200
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sleeveLookup": {
      "type": "object",
      "required": [
        "status",
        "provider",
        "checked_at",
        "editions"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_checked",
            "found",
            "not_found",
            "withdrawn",
            "needs_review"
          ]
        },
        "provider": {
          "enum": [
            "videotapes_io",
            "internet_archive",
            "manual"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "editions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edition"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "found"
              }
            }
          },
          "then": {
            "properties": {
              "editions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "editions": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "edition": {
      "type": "object",
      "required": [
        "edition_id",
        "provider",
        "source_url",
        "authenticity"
      ],
      "properties": {
        "edition_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "videotapes_io",
            "internet_archive",
            "manual"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2200
        },
        "distributor": {
          "type": [
            "string",
            "null"
          ]
        },
        "authenticity": {
          "enum": [
            "official",
            "fan_made",
            "unknown"
          ]
        }
      }
    },
    "artwork": {
      "type": "object",
      "required": [
        "signature_asset_id",
        "assets"
      ],
      "properties": {
        "signature_asset_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "provider",
        "kind",
        "source_url",
        "reuse_policy",
        "display_status"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "tmdb",
            "videotapes_io",
            "internet_archive",
            "manual"
          ]
        },
        "edition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "vhs_sleeve_spread",
            "vhs_front",
            "vhs_spine",
            "vhs_back",
            "vhs_label",
            "tmdb_poster",
            "tmdb_backdrop",
            "tmdb_logo",
            "archive_cover",
            "other"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Public source image URL or documented provider image endpoint reference. The image itself is never stored by VHS FEVER."
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "folds": {
          "$ref": "#/$defs/folds"
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reuse_policy": {
          "enum": [
            "link_only",
            "provider_terms",
            "cc0",
            "cc_by",
            "cc_by_sa",
            "public_domain",
            "permission_granted",
            "permission_required",
            "unknown"
          ]
        },
        "display_status": {
          "enum": [
            "approved",
            "link_only",
            "pending_review",
            "blocked"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Stable identifier assigned by the source provider, when available."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "tmdb"
              }
            }
          },
          "then": {
            "required": [
              "attribution"
            ],
            "properties": {
              "attribution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "description": "URL/reference-only artwork metadata. VHS FEVER must not store image bytes, local file paths, mirrors, proxies, or generated thumbnails.",
      "additionalProperties": false
    },
    "folds": {
      "type": "object",
      "required": [
        "left",
        "right",
        "source"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "enum": [
            "measured",
            "provider",
            "unknown"
          ]
        }
      }
    }
  }
}
